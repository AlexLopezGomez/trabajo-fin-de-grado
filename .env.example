# ===========================================
# AI Query Dashboard - Environment Variables
# ===========================================

# Database - Project/Business data (per-namespace, different per deployment)
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=your_project_database_name

# Database - Auth/Platform data (shared across deployments)
# If omitted, falls back to MONGODB_URI with AUTH_DATABASE
AUTH_MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_AUTH_CLUSTER.mongodb.net/?retryWrites=true&w=majority
AUTH_DATABASE=your_auth_database_name

# AI 
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_HERE
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SESSION_MAX_AGE=28800

# Google OAuth 
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_SECRET
ALLOWED_EMAIL_DOMAIN=yourcompany.com

# Rate Limiting - Upstash Redis (optional, falls back to in-memory)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# Slack Notifications
SLACK_APPROVALS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_SECURITY_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Football Scraper — Cloudflare Browser Rendering API
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_api_token_with_browser_rendering_edit_permission
TARGET_LEAGUE=Spain La Liga
TARGET_SEASON=24/25

# Football Data API (matches + standings — register free at football-data.org/client/register)
FOOTBALL_DATA_API_KEY=your_key_here

